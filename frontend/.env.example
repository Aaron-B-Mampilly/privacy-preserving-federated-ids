# Base URL of the FedPDA-IDS FastAPI backend.
# The API defaults to port 8001 because 8000 is used by the project's
# Prometheus exporter during live training runs.
VITE_API_BASE=http://localhost:8001/api

# Grafana lives alongside this app as the technical observability layer.
VITE_GRAFANA_URL=http://localhost:3000
